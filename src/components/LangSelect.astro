/*
 * LangSelect — 简繁语言切换下拉（博客版，工艺镜像主站同名组件，
 * 有意简化处）：
 *   1) 无埋点：博客无 Zaraz/GA4，change 直接跳 pathname（主站的 300ms setTimeout 为等埋点 POST）；
 *   2) URL 配对由调用方（Header）算好传入 otherHref——文章页 slug 双语同名=前缀互换；
 *      标签/作者页 slug=标签原文天然不对称，调用方给对侧博客首页。
 * 触发器显示**当前语言**（用户第 4 轮裁决：按钮文字与当前页永远相反会误导读者），
 * markup/class 对齐主站与 Starlight 0.42 LanguageSelect + Select 形态。
 *
 * No-JS：渲染原生 select、显示当前语言；跳转需 JS，降级水平与原生 LanguageSelect 相同。
 */

interface Props {
	/** 当前语言名（触发器显示 + 展开态高亮禁用项）。 */
	currentLabel: string;
	/** 另一语言名（可点项）。 */
	otherLabel: string;
	/** 另一语言链接（站内相对路径，由调用方给出）。 */
	otherHref: string;
	/** 无障碍名称。 */
	ariaLabel?: string;
}

const { currentLabel, otherLabel, otherHref, ariaLabel = '语言' } = Astro.props;

