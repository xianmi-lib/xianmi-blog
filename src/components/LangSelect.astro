---
/*
 * LangSelect — 简繁语言切换下拉（博客版，工艺镜像主站同名组件，
 * 有意简化处）：
 *   1) 无埋点：博客无 Zaraz/GA4，change 直接跳 pathname（主站的 300ms setTimeout 为等埋点 POST）；
 *   2) URL 配对由调用方（Header）算好传入 otherHref——文章页 slug 双语同名=前缀互换；
 *      标签/作者页 slug=标签原文天然不对称，调用方给对侧博客首页。
 * 触发器显示**当前语言**（用户第 4 轮裁决：按钮文字与当前页永远相反会误导读者），
 * markup/class 对齐主站与 Starlight 0.42 LanguageSelect + Select 形态。
 *
 * No-JS：渲染原生 select、显示当前语言；跳转需 JS，降级水平与原生 LanguageSelect 相同。
 */

interface Props {
	/** 当前语言名（触发器显示 + 展开态高亮禁用项）。 */
	currentLabel: string;
	/** 另一语言名（可点项）。 */
	otherLabel: string;
	/** 另一语言链接（站内相对路径，由调用方给出）。 */
	otherHref: string;
	/** 无障碍名称。 */
	ariaLabel?: string;
}

const { currentLabel, otherLabel, otherHref, ariaLabel = '语言' } = Astro.props;

// 简繁图标（2026-10-16 用户定稿 E 版：无框 漢/汉 斜向交叠——语义=同文简繁两版本、非互译故无箭头；随站调换=当前文字形态在前，cn=漢后/汉前；前字经 mask 真镂空（纯色描边在半透明 header 底上会露光环）；字形=Noto Serif SC Bold 轮廓提取（OFL），生成脚本 ~/xianmi-evidence/lang-icon-20261016/gen-icon-e.py）
// 多实例同页（Header+Sidebar+移动端链接）⇒ mask id 每实例随机，防引用串位
const maskId = `langswap-${Math.random().toString(36).slice(2, 8)}`;
const dHanBack = 'M12.66 105.54C10.93 105.54 5.41 105.54 5.41 105.54V108.54C8.72 108.85 11.40 109.48 13.61 111.06C17.39 113.58 18.02 128.23 15.18 144.78C16.28 150.61 19.91 152.97 23.53 152.97C31.10 152.97 36.30 147.77 36.61 139.74C37.08 125.87 30.78 120.04 30.47 111.69C30.31 107.75 31.57 102.08 32.83 96.72C35.03 88.37 46.06 52.92 52.21 33.70L49.85 32.91C20.85 96.41 20.85 96.41 17.39 102.24C15.65 105.39 14.87 105.54 12.66 105.54ZM13.29 6.91 12.03 7.86C17.70 13.69 24.48 22.98 26.68 31.33C43.23 41.57 55.99 10.22 13.29 6.91ZM5.26 41.73 4.0 42.68C9.19 48.35 14.55 57.17 15.50 65.37C30.78 76.55 45.43 46.93 5.26 41.73ZM105.78 5.02V21.72H85.77V11.32C90.02 10.69 91.13 9.12 91.60 6.91L69.38 5.02V21.72H45.43L46.69 26.29H69.38V43.94H72.53C78.84 43.94 85.77 42.20 85.77 41.10H86.87V52.29H70.49L53.15 45.51V88.69H55.52C62.14 88.69 69.54 85.22 69.54 83.64V79.86H86.87V86.32L86.72 93.73H50.48L51.74 98.14H86.40C85.93 102.87 84.98 107.44 83.72 111.69H44.33L45.59 116.10H82.15C76.16 130.12 63.40 141.31 37.87 150.92L38.82 152.66C76.16 145.09 92.55 132.17 99.64 116.10H102.47C109.72 134.22 121.54 145.57 140.76 152.18C142.34 142.89 147.06 136.90 153.84 134.85L153.99 133.28C135.56 131.70 117.13 126.03 106.73 116.10H148.01C150.21 116.10 151.95 115.31 152.42 113.58C145.80 107.91 134.93 99.71 134.93 99.56L125.48 111.69H101.21C102.63 107.44 103.57 102.87 104.05 98.14H141.55C143.60 98.14 145.33 97.35 145.64 95.62C141.23 91.84 135.09 87.11 131.78 84.59C136.19 83.64 140.76 81.91 140.92 81.12V59.06C143.60 58.43 145.49 57.33 146.43 56.23L129.57 43.94L121.85 52.29H104.52V41.10H105.78V43.15H108.93C115.55 43.15 122.64 41.42 122.64 40.47V26.29H148.80C151.00 26.29 152.42 25.50 152.89 23.77C147.22 18.25 137.77 10.53 137.77 10.53L129.42 21.72H122.64V11.32C126.74 10.69 128.00 9.12 128.31 6.91ZM127.21 85.22 120.28 93.73H104.36L104.52 86.01V79.86H123.43V85.22H126.42ZM123.43 75.29H104.52V56.70H123.43ZM86.87 75.29H69.54V56.70H86.87ZM86.87 36.69H85.77V26.29H105.78V36.69Z';
const dHanFront = 'M113.88 202.18C112.16 202.18 106.69 202.18 106.69 202.18V205.15C110.13 205.46 112.63 206.09 114.82 207.65C118.57 210.15 119.20 224.86 116.38 241.28C117.48 247.22 121.23 249.41 124.99 249.41C132.50 249.41 137.66 244.10 137.97 236.28C138.44 222.20 132.03 216.72 131.87 208.28C131.71 204.21 132.81 198.58 134.06 193.26C136.09 184.66 147.04 148.68 153.14 129.45L150.64 128.82C121.86 192.95 121.86 192.95 118.42 198.89C116.85 202.02 116.07 202.18 113.88 202.18ZM103.25 140.08 102.0 141.02C107.78 146.65 114.35 155.88 116.38 164.17C132.96 174.49 145.63 143.05 103.25 140.08ZM116.23 104.58 114.98 105.67C120.76 111.77 127.49 121.31 129.68 130.23C146.73 141.18 160.49 108.64 116.23 104.58ZM188.96 203.59C176.60 220.79 160.81 235.81 141.10 247.22L142.51 248.94C165.03 240.34 182.55 228.77 196.31 215.16C206.01 228.61 217.43 239.56 231.04 248.63C235.26 240.34 242.61 235.49 251.06 235.34L252.0 233.62C235.73 225.95 220.40 215.79 207.42 202.49C224.47 180.75 234.01 154.94 239.95 128.04C244.02 127.57 245.74 127.10 246.83 125.22L229.94 109.58L220.09 119.90H150.48L151.89 124.28H164.87C169.10 156.97 177.07 182.94 188.96 203.59ZM197.25 190.92C183.33 173.24 173.01 151.34 167.84 124.28H221.34C216.96 147.90 209.14 170.74 197.25 190.92Z';
---

<lp-lang-select class="lp-lang-select">
	<label>
		<span class="sr-only">{ariaLabel}</span>
		<svg class="icon label-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 256 256" fill="currentColor">
			<mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="0" width="256" height="256">
				<rect width="256" height="256" fill="#fff" />
				<path d={dHanFront} fill="#000" stroke="#000" stroke-width="16" stroke-linejoin="round" />
			</mask>
			<g mask={`url(#${maskId})`}><path d={dHanBack} /></g>
			<path d={dHanFront} />
		</svg>
		<select autocomplete="off" aria-label={ariaLabel}>
			<option value="" selected disabled>{currentLabel}</option>
			<option value={otherHref}>{otherLabel}</option>
		</select>
		<svg class="icon caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
			<path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"></path>
		</svg>
	</label>
</lp-lang-select>

<script>
	// 页面上可能有多个实例，一并接线。行为镜像原生 LanguageSelect：change 跳
	// pathname；pageshow（bfcache 恢复）时按 markup 的 option[selected] 复位显示值。
	for (const select of document.querySelectorAll<HTMLSelectElement>('.lp-lang-select select')) {
		select.addEventListener('change', () => {
			if (select.value) {
				window.location.pathname = select.value;
			}
		});
		window.addEventListener('pageshow', (event) => {
			if (!event.persisted) return;
			const markupSelectedIndex = select.querySelector('option[selected]')?.index;
			if (markupSelectedIndex !== select.selectedIndex) {
				select.selectedIndex = markupSelectedIndex ?? 0;
			}
		});
	}
</script>

<style>
	@layer starlight.core {
		.lp-lang-select label {
			--sl-label-icon-size: 1.25rem;
			--sl-caret-size: 1.25rem;
			--sl-inline-padding: 0.5rem;
			position: relative;
			display: flex;
			align-items: center;
			gap: 0.25rem;
			color: var(--sl-color-gray-2);
		}

		/* 与头部控件族一致（透明底灰字 hover accent-high） */
		.lp-lang-select label:is(:hover, :focus-within) {
			color: var(--sl-color-accent-high);
		}

		.label-icon,
		.caret {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			pointer-events: none;
		}

		.label-icon {
			inset-inline-start: 0;
			width: var(--sl-label-icon-size);
			height: var(--sl-label-icon-size);
		}

		.caret {
			inset-inline-end: 0;
			font-size: var(--sl-caret-size);
			width: 1em;
			height: 1em;
		}

		.lp-lang-select select {
			border: 0;
			padding-block: 0.625rem;
			padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
				calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
			margin-inline: calc(var(--sl-inline-padding) * -1);
			background-color: transparent;
			color: inherit;
			cursor: pointer;
			appearance: none;
		}

		.lp-lang-select option {
			background-color: var(--sl-color-bg-nav);
			color: var(--sl-color-gray-1);
		}

		@media (min-width: 50rem) {
			.lp-lang-select select {
				font-size: var(--sl-text-sm);
			}
		}
	}
</style>
