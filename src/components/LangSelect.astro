---
/*
 * LangSelect — 简繁语言切换下拉（博客版，工艺镜像主站 xianmi-cn/src/components/LangSelect.astro，
 * 有意简化处）：
 *   1) 无埋点：博客无 Zaraz/GA4，change 直接跳 pathname（主站的 300ms setTimeout 为等埋点 POST）；
 *   2) URL 配对由调用方（Header）算好传入 otherHref——文章页 slug 双语同名=前缀互换；
 *      标签/作者页 slug=标签原文天然不对称，调用方给对侧博客首页。
 * 触发器显示**当前语言**（用户第 4 轮裁决：按钮文字与当前页永远相反会误导读者），
 * markup/class 对齐主站与 Starlight 0.42 LanguageSelect + Select 形态。
 *
 * No-JS：渲染原生 select、显示当前语言；跳转需 JS，降级水平与原生 LanguageSelect 相同。
 */

interface Props {
	/** 当前语言名（触发器显示 + 展开态高亮禁用项）。 */
	currentLabel: string;
	/** 另一语言名（可点项）。 */
	otherLabel: string;
	/** 另一语言链接（站内相对路径，由调用方给出）。 */
	otherHref: string;
	/** 无障碍名称。 */
	ariaLabel?: string;
}

const { currentLabel, otherLabel, otherHref, ariaLabel = '语言' } = Astro.props;

// Starlight 内置 translate 图标
const translateIcon =
	'<path fill-rule="evenodd" d="M8.516 3a.94.94 0 0 0-.941.94v1.15H2.94a.94.94 0 1 0 0 1.882h7.362a7.422 7.422 0 0 1-1.787 3.958 7.42 7.42 0 0 1-1.422-2.425.94.94 0 1 0-1.774.627 9.303 9.303 0 0 0 1.785 3.043 7.422 7.422 0 0 1-4.164 1.278.94.94 0 1 0 0 1.881 9.303 9.303 0 0 0 5.575-1.855 9.303 9.303 0 0 0 4.11 1.74l-.763 1.525a.968.968 0 0 0-.016.034l-1.385 2.77a.94.94 0 1 0 1.683.841l1.133-2.267h5.806l1.134 2.267a.94.94 0 0 0 1.683-.841l-1.385-2.769a.95.95 0 0 0-.018-.036l-3.476-6.951a.94.94 0 0 0-1.682 0l-1.82 3.639a7.423 7.423 0 0 1-3.593-1.256 9.303 9.303 0 0 0 2.27-5.203h1.894a.94.94 0 0 0 0-1.881H9.456V3.94A.94.94 0 0 0 8.516 3Zm6.426 11.794a1.068 1.068 0 0 1-.02.039l-.703 1.407h3.924l-1.962-3.924-1.24 2.478Z" clip-rule="evenodd"/>';
---

<lp-lang-select class="lp-lang-select">
	<label>
		<span class="sr-only">{ariaLabel}</span>
		<svg class="icon label-icon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" set:html={translateIcon} />
		<select autocomplete="off" aria-label={ariaLabel}>
			<option value="" selected disabled>{currentLabel}</option>
			<option value={otherHref}>{otherLabel}</option>
		</select>
		<svg class="icon caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
			<path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"></path>
		</svg>
	</label>
</lp-lang-select>

<script>
	// 页面上可能有多个实例，一并接线。行为镜像原生 LanguageSelect：change 跳
	// pathname；pageshow（bfcache 恢复）时按 markup 的 option[selected] 复位显示值。
	for (const select of document.querySelectorAll<HTMLSelectElement>('.lp-lang-select select')) {
		select.addEventListener('change', () => {
			if (select.value) {
				window.location.pathname = select.value;
			}
		});
		window.addEventListener('pageshow', (event) => {
			if (!event.persisted) return;
			const markupSelectedIndex = select.querySelector('option[selected]')?.index;
			if (markupSelectedIndex !== select.selectedIndex) {
				select.selectedIndex = markupSelectedIndex ?? 0;
			}
		});
	}
</script>

<style>
	@layer starlight.core {
		.lp-lang-select label {
			--sl-label-icon-size: 1rem;
			--sl-caret-size: 1.25rem;
			--sl-inline-padding: 0.5rem;
			position: relative;
			display: flex;
			align-items: center;
			gap: 0.25rem;
			color: var(--sl-color-gray-2);
		}

		/* 与头部控件族一致（透明底灰字 hover accent-high） */
		.lp-lang-select label:is(:hover, :focus-within) {
			color: var(--sl-color-accent-high);
		}

		.label-icon,
		.caret {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			pointer-events: none;
		}

		.label-icon {
			inset-inline-start: 0;
			width: var(--sl-label-icon-size);
			height: var(--sl-label-icon-size);
		}

		.caret {
			inset-inline-end: 0;
			font-size: var(--sl-caret-size);
			width: 1em;
			height: 1em;
		}

		.lp-lang-select select {
			border: 0;
			padding-block: 0.625rem;
			padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
				calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
			margin-inline: calc(var(--sl-inline-padding) * -1);
			background-color: transparent;
			color: inherit;
			cursor: pointer;
			appearance: none;
		}

		.lp-lang-select option {
			background-color: var(--sl-color-bg-nav);
			color: var(--sl-color-gray-1);
		}

		@media (min-width: 50rem) {
			.lp-lang-select select {
				font-size: var(--sl-text-sm);
			}
		}
	}
</style>
