---
// 博客页脚：显密文库署名 + 主站链接（博客不复制主站元页面，一律绝对链）。
// cooler-credit 赞助卡后补（立项单注明可后补），届时在此叠加。
// 简繁判定用 defaultLocale.label（Starlight 0.42 单 root locale 不保留 locales 键，
// config.locales?.root?.label 恒 false——同 Header 已修坑，见 AGENTS 已知坑）。
import Default from '@astrojs/starlight/components/Footer.astro';
import config from 'virtual:starlight/user-config';

const isTw = config.defaultLocale?.label === '繁體中文';
const links = isTw
	? [
			['文庫首頁', 'https://www.xianmi.co/zh-tw/'],
			['贊助護持', 'https://www.xianmi.co/zh-tw/contribute/'],
			['隱私政策', 'https://www.xianmi.co/zh-tw/privacy/'],
		]
	: [
			['文库首页', 'https://www.xianmi.co/'],
			['赞助护持', 'https://www.xianmi.co/contribute/'],
			['隐私政策', 'https://www.xianmi.co/privacy/'],
		];
---

<Default {...Astro.props}><slot /></Default>
<nav class="footer-links sl-flex" aria-label={isTw ? '站點資訊' : '站点信息'}>
	{links.map(([label, href], i) => (
		<>
			{i > 0 && <span aria-hidden="true">·</span>}
			<a href={href}>{label}</a>
		</>
	))}
</nav>
<div class="footer-copy">{isTw ? '© 2021–2026 xianmi.co · 顯密文庫博客' : '© 2021–2026 xianmi.co · 显密文库博客'}</div>
<div class="footer-ai-note">{isTw ? '本站部落格文章由編輯與 AI 協作完成' : '本站博客文章由编辑与 AI 协作完成'}</div>

<style>
	.footer-links {
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.footer-links a {
		color: inherit;
		text-decoration: none;
	}
	.footer-links a:hover {
		color: var(--sl-color-text-accent);
	}
	.footer-copy {
		margin-top: 0.375rem;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
	}
	/* AI 协作透明声明（2026-10-13 预防性对齐 Google 有用内容新规）：弱化置灰，不打扰阅读 */
	.footer-ai-note {
		margin-top: 0.25rem;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-5);
	}
</style>
